<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= content_for(:title) || "Super Admin Console" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Bokunokoto Super Admin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Tailwind CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              primary: { DEFAULT: '#3C50E0', dark: '#80CAEE' },
              stroke: { DEFAULT: '#E2E8F0', dark: '#2E3A47', form: '#d5d9e2' },
              boxdark: { DEFAULT: '#24303F', 2: '#313D4A' },
              body: { DEFAULT: '#64748B', dark: '#AEB7C0' },
              bodydark: { DEFAULT: '#AEB7C0', 1: '#DEE4EE', 2: '#8A99AF' },
              graydark: { DEFAULT: '#333D4A' },
              whiten: { DEFAULT: '#F1F5F9' },
              danger: { DEFAULT: '#DC3545' },
              success: { DEFAULT: '#219653' },
              warning: { DEFAULT: '#F9C107' },
              meta: { 4: '#313D4A' }
            }
          }
        }
      }
    </script>
    <%= javascript_importmap_tags %>
    <style>
      .no-scrollbar::-webkit-scrollbar { display: none; }
      .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
      .nav-group-title { 
        font-size: 0.75rem; 
        text-transform: uppercase; 
        letter-spacing: 0.05em; 
        color: #8A99AF; 
        padding: 1.5rem 1rem 0.5rem;
        font-weight: 700;
      }
      .z-99999 { z-index: 99999; }
      .z-9999 { z-index: 9999; }
      .z-999 { z-index: 999; }
    </style>
  </head>

  <body class="h-full bg-whiten font-sans text-body dark:bg-boxdark-2 dark:text-bodydark">
    <div class="flex h-screen overflow-hidden bg-whiten dark:bg-boxdark-2" data-controller="dark-mode sidebar">
      <!-- Hidden checkbox for dark-mode controller -->
      <input type="checkbox" id="dark-mode-checkbox" class="hidden" data-dark-mode-target="checkbox" data-action="change->dark-mode#toggle">

      <!-- Sidebar Start -->
      <aside
        id="sidebar"
        data-sidebar-target="sidebar"
        class="absolute left-0 top-0 z-9999 flex h-screen w-72.5 flex-col overflow-y-hidden bg-black duration-300 ease-linear dark:bg-boxdark lg:static lg:translate-x-0 -translate-x-full"
      >
        <!-- SIDEBAR HEADER -->
        <div class="flex items-center justify-between gap-2 px-6 py-5.5 lg:py-6.5">
          <%= link_to super_admin_root_path, class: "flex items-center gap-2" do %>
            <span class="text-2xl font-bold text-white">Bokunokoto</span>
            <span class="rounded bg-primary px-2 py-1 text-xs font-medium text-white">ADMIN</span>
          <% end %>

          <button
            class="block lg:hidden text-white"
            data-action="click->sidebar#toggle"
          >
            <svg class="fill-current" width="20" height="18" viewBox="0 0 20 18" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M19 8.175H2.98748L9.36248 1.6875C9.69998 1.35 9.69998 0.825 9.36248 0.4875C9.02498 0.15 8.49998 0.15 8.16248 0.4875L0.399976 8.3625C0.0624756 8.7 0.0624756 9.225 0.399976 9.5625L8.16248 17.4375C8.31248 17.5875 8.53748 17.7 8.76248 17.7C8.98748 17.7 9.17498 17.625 9.36248 17.475C9.69998 17.1375 9.69998 16.6125 9.36248 16.275L3.02498 9.8625H19C19.45 9.8625 19.825 9.4875 19.825 9.0375C19.825 8.55 19.45 8.175 19 8.175Z" fill="currentColor" />
            </svg>
          </button>
        </div>
        <!-- SIDEBAR HEADER -->

        <div class="no-scrollbar flex flex-col overflow-y-auto duration-300 ease-linear">
          <!-- Sidebar Menu -->
          <nav class="mt-5 px-4 py-4 lg:mt-9 lg:px-6">
            <!-- Menu Group -->
            <div>
              <div class="nav-group-title">Platform</div>
              <ul class="mb-6 flex flex-col gap-1.5">
                <li>
                  <%= link_to super_admin_root_path, class: "group relative flex items-center gap-2.5 rounded-sm py-2 px-4 font-medium duration-300 ease-in-out hover:bg-graydark dark:hover:bg-meta-4 #{current_page?(super_admin_root_path) ? 'bg-graydark dark:bg-meta-4 text-white' : 'text-bodydark2 hover:text-white'}" do %>
                    <svg class="fill-current" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                       <path d="M16.1 1.9H1.9C1.3 1.9 0.9 2.3 0.9 2.9V15.1C0.9 15.7 1.3 16.1 1.9 16.1H16.1C16.7 16.1 17.1 15.7 17.1 15.1V2.9C17.1 2.3 16.7 1.9 16.1 1.9ZM1.9 15.1V3.9H16.1V15.1H1.9Z" fill="currentColor"/>
                    </svg>
                    Dashboard
                  <% end %>
                </li>
              </ul>
            </div>

            <div>
              <div class="nav-group-title">Firebase & Logic</div>
              <ul class="mb-6 flex flex-col gap-1.5">
                <li>
                  <%= link_to super_admin_firestore_index_path, class: "group relative flex items-center gap-2.5 rounded-sm py-2 px-4 font-medium duration-300 ease-in-out hover:bg-graydark dark:hover:bg-meta-4 hover:text-white #{current_page?(super_admin_firestore_index_path) ? 'bg-graydark dark:bg-meta-4 text-white' : 'text-bodydark2'}" do %>
                    <svg class="fill-current" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M9 1.1L2 4.1V13.9L9 16.9L16 13.9V4.1L9 1.1ZM14.2 12.8L9 15.1L3.8 12.8V5.2L9 2.9L14.2 5.2V12.8Z" fill="currentColor"/>
                    </svg>
                    Firestore Data
                  <% end %>
                </li>
                <li>
                  <%= link_to super_admin_remote_config_index_path, class: "group relative flex items-center gap-2.5 rounded-sm py-2 px-4 font-medium duration-300 ease-in-out hover:bg-graydark dark:hover:bg-meta-4 hover:text-white #{current_page?(super_admin_remote_config_index_path) ? 'bg-graydark dark:bg-meta-4 text-white' : 'text-bodydark2'}" do %>
                    <svg class="fill-current" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M15 9V7H13V5H11V3H7V5H5V7H3V9H1V11H3V13H5V15H7V17H11V15H13V13H15V11H17V9H15ZM13 11H11V13H7V11H5V7H7V5H11V7H13V11Z" fill="currentColor"/>
                    </svg>
                    Remote Config
                  <% end %>
                </li>
              </ul>
            </div>
          </nav>
        </div>
      </aside>

      <!-- Content Area Start -->
      <div class="relative flex flex-1 flex-col overflow-y-auto overflow-x-hidden">
        <!-- Header Start -->
        <header class="sticky top-0 z-999 flex w-full bg-white drop-shadow-1 dark:bg-boxdark dark:drop-shadow-none">
          <div class="flex flex-grow items-center justify-between px-4 py-4 shadow-2 md:px-6 2xl:px-11">
            <div class="flex items-center gap-2 sm:gap-4 lg:hidden">
              <button
                class="z-99999 block rounded-sm border border-stroke bg-white p-1.5 shadow-sm dark:border-strokedark dark:bg-boxdark lg:hidden"
                data-action="click->sidebar#toggle"
              >
                <span class="relative block h-5.5 w-5.5 cursor-pointer">
                  <span class="du-block absolute right-0 h-full w-full">
                    <span class="relative left-0 top-0 my-1 block h-0.5 w-full rounded-sm bg-primary duration-200 ease-in-out" data-sidebar-target="line1"></span>
                    <span class="relative left-0 top-0 my-1 block h-0.5 w-full rounded-sm bg-primary duration-200 ease-in-out" data-sidebar-target="line2"></span>
                    <span class="relative left-0 top-0 my-1 block h-0.5 w-full rounded-sm bg-primary duration-200 ease-in-out" data-sidebar-target="line3"></span>
                  </span>
                </span>
              </button>
            </div>

            <div class="hidden sm:block"></div>

            <div class="flex items-center gap-3 2xl:gap-7">
              <!-- Dark Mode Toggler -->
              <label
                for="dark-mode-checkbox"
                class="relative flex h-8.5 w-8.5 cursor-pointer items-center justify-center rounded-full border-[0.5px] border-stroke bg-gray hover:text-primary dark:border-strokedark dark:bg-meta-4 dark:text-white"
              >
                <svg class="fill-current duration-300 ease-in-out" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M8 12C10.2091 12 12 10.2091 12 8C12 5.79086 10.2091 4 8 4C5.79086 4 4 5.79086 4 8C4 10.2091 5.79086 12 8 12Z" fill="currentColor"/>
                </svg>
              </label>

              <!-- User Area -->
              <div class="relative" data-controller="dropdown">
                <%= link_to "#", class: "flex items-center gap-4", data: { action: "click->dropdown#toggle" } do %>
                  <span class="hidden text-right lg:block">
                    <span class="block text-sm font-medium text-black dark:text-white"><%= current_manager&.email || "Super Admin" %></span>
                    <span class="block text-xs font-medium text-body dark:text-bodydark2 uppercase"><%= current_manager&.role || "Operator" %></span>
                  </span>
                  <span class="h-11 w-11 rounded-full bg-primary flex items-center justify-center text-white font-bold shadow-default">
                    <%= current_manager&.email&.first&.upcase || "A" %>
                  </span>
                <% end %>

                <!-- Dropdown -->
                <div
                  data-dropdown-target="menu"
                  class="absolute right-0 mt-4 flex w-62.5 flex-col rounded-sm border border-stroke bg-white shadow-dropdown dark:border-strokedark dark:bg-boxdark hidden z-[9999]"
                >
                  <ul class="flex flex-col border-b border-stroke dark:border-strokedark">
                    <li>
                      <%= link_to "#", class: "flex items-center gap-3.5 px-6 py-4 text-sm font-medium duration-300 ease-in-out hover:text-primary lg:text-base text-black dark:text-white border-b border-stroke dark:border-strokedark" do %>
                        Profile Settings
                      <% end %>
                    </li>
                    <li>
                      <%= link_to super_admin_session_path, data: { "turbo-method": :delete }, class: "flex items-center gap-3.5 px-6 py-4 text-sm font-medium duration-300 ease-in-out hover:text-danger lg:text-base w-full text-left bg-transparent border-none cursor-pointer text-black dark:text-white" do %>
                        Sign Out
                      <% end %>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </header>
        <!-- Header End -->

        <!-- Main Content -->
        <main class="flex-1 bg-whiten dark:bg-boxdark-2">
          <div class="mx-auto max-w-screen-2xl p-4 md:p-6 2xl:p-10">
            <% if notice.present? %>
              <div class="mb-6 flex w-full border-l-6 border-success bg-success bg-opacity-[15%] px-7 py-8 shadow-default dark:bg-[#1B1B24] dark:bg-opacity-30">
                 <div class="w-full">
                  <h5 class="mb-3 text-lg font-semibold text-success">Success</h5>
                  <p class="text-base leading-relaxed text-body dark:text-bodydark"><%= notice %></p>
                </div>
              </div>
            <% end %>
            <% if alert.present? %>
              <div class="mb-6 flex w-full border-l-6 border-danger bg-danger bg-opacity-[15%] px-7 py-8 shadow-default dark:bg-[#1B1B24] dark:bg-opacity-30">
                <div class="w-full">
                  <h5 class="mb-3 text-lg font-semibold text-danger">Alert</h5>
                  <p class="text-base leading-relaxed text-body dark:text-bodydark"><%= alert %></p>
                </div>
              </div>
            <% end %>
            <%= yield %>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
