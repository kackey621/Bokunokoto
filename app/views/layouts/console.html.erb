<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "System Console" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Bokunokoto Console">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="stylesheet" href="<%= asset_path("css/coreui.min.css") %>">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="console-body">
    <div class="sidebar sidebar-dark sidebar-fixed border-end" id="sidebar">
      <div class="sidebar-header border-bottom">
        <%= link_to console_path, class: "sidebar-brand text-decoration-none" do %>
          <span class="sidebar-brand-full fw-semibold">Bokunokoto</span>
          <span class="sidebar-brand-narrow fw-semibold">BK</span>
        <% end %>
      </div>

      <ul class="sidebar-nav" data-coreui="navigation">
        <li class="nav-title">Control Plane</li>
        <li class="nav-item">
          <%= link_to console_path, class: "nav-link #{current_page?(console_path) ? "active" : ""}" do %>
            <span class="nav-icon"><span class="nav-icon-bullet"></span></span> Dashboard
          <% end %>
        </li>
        <li class="nav-item">
          <%= link_to console_users_path, class: "nav-link #{controller_path == "console/users" ? "active" : ""}" do %>
            <span class="nav-icon"><span class="nav-icon-bullet"></span></span> User Management
          <% end %>
        </li>
        <li class="nav-title">Systems</li>
        <li class="nav-item">
          <%= link_to api_v1_health_path, class: "nav-link" do %>
            <span class="nav-icon"><span class="nav-icon-bullet"></span></span> API Health
          <% end %>
        </li>
        <li class="nav-item">
          <%= link_to "http://localhost:8025", class: "nav-link", target: "_blank", rel: "noopener" do %>
            <span class="nav-icon"><span class="nav-icon-bullet"></span></span> Mailpit
          <% end %>
        </li>
      </ul>
    </div>

    <div class="wrapper d-flex flex-column min-vh-100">
      <header class="header header-sticky p-0 border-bottom">
        <div class="container-fluid">
          <button class="header-toggler px-md-0 me-md-3" type="button" data-coreui-toggle="sidebar" data-coreui-target="#sidebar" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb my-0">
              <li class="breadcrumb-item"><%= link_to "Console", console_path %></li>
              <li class="breadcrumb-item active" aria-current="page"><%= content_for(:console_title) || content_for(:title) || "Dashboard" %></li>
            </ol>
          </nav>
          <div class="ms-auto d-flex align-items-center gap-3 small text-body-secondary">
            <span>Rails API</span>
            <span class="badge text-bg-success">Online</span>
          </div>
        </div>
      </header>

      <main class="body flex-grow-1">
        <div class="container-lg px-4 py-4">
          <% if notice.present? %>
            <div class="alert alert-success" role="alert"><%= notice %></div>
          <% end %>
          <%= yield %>
        </div>
      </main>
    </div>

    <script src="<%= asset_path("js/coreui.bundle.min.js") %>"></script>
  </body>
</html>
