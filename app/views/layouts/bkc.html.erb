<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "BKC Command Center" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Bokunokoto BKC">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link href="https://cdn.jsdelivr.net/npm/@coreui/coreui@5.4.3/dist/css/coreui.min.css" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bkc-body">
    <div class="sidebar sidebar-dark sidebar-fixed border-end" id="sidebar">
      <div class="sidebar-header border-bottom">
        <%= link_to bkc_dashboard_path, class: "sidebar-brand text-decoration-none" do %>
          <span class="sidebar-brand-full fw-semibold">BK Command Center</span>
          <span class="sidebar-brand-narrow fw-semibold">BKC</span>
        <% end %>
      </div>

      <ul class="sidebar-nav" data-coreui="navigation">
        <li class="nav-title">Management</li>
        <li class="nav-item">
          <%= link_to bkc_dashboard_path, class: "nav-link #{current_page?(bkc_dashboard_path) ? "active" : ""}" do %>
            <span class="nav-icon"><span class="nav-icon-bullet"></span></span> Dashboard
          <% end %>
        </li>
        <li class="nav-item">
          <%= link_to bkc_vaults_path, class: "nav-link #{current_page?(bkc_vaults_path) ? "active" : ""}" do %>
            <span class="nav-icon"><span class="nav-icon-bullet"></span></span> Vaults
          <% end %>
        </li>
        <% if current_vault %>
          <li class="nav-item">
            <%= link_to bkc_contents_path, class: "nav-link #{current_page?(bkc_contents_path) ? "active" : ""}" do %>
              <span class="nav-icon"><span class="nav-icon-bullet"></span></span> Contents
            <% end %>
          </li>
          <li class="nav-item">
            <%= link_to bkc_viewers_path, class: "nav-link #{current_page?(bkc_viewers_path) ? "active" : ""}" do %>
              <span class="nav-icon"><span class="nav-icon-bullet"></span></span> Viewers
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="wrapper d-flex flex-column min-vh-100" style="padding-left: var(--cui-sidebar-occupy-start, 0);">
      <header class="header header-sticky p-0 border-bottom">
        <div class="container-fluid px-4">
          <button class="header-toggler px-md-0 me-md-3" type="button" data-coreui-toggle="sidebar" data-coreui-target="#sidebar" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb my-0">
              <li class="breadcrumb-item"><%= link_to "BKC", bkc_dashboard_path %></li>
              <li class="breadcrumb-item active"><%= content_for(:bkc_title) || "Dashboard" %></li>
            </ol>
          </nav>
          <div class="ms-auto d-flex align-items-center gap-4">
            <div class="d-none d-sm-flex flex-column align-items-end line-height-1">
              <span class="small fw-semibold"><%= current_user.display_name %></span>
              <span class="small text-body-secondary" style="font-size: 0.75rem;">Manager</span>
            </div>
            <%= button_to bkc_session_path, method: :delete, class: "btn btn-outline-danger btn-sm d-flex align-items-center gap-2", data: { turbo: false } do %>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-box-arrow-right" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0v2z"/>
                <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3z"/>
              </svg>
              Logout
            <% end %>
          </div>
        </div>
      </header>

      <main class="body flex-grow-1">
        <div class="container-lg px-4 py-4">
          <% if current_operator_override %>
            <div class="alert alert-danger border-danger fw-semibold d-flex align-items-center gap-3" role="alert">
              <span>
                OPERATOR OVERRIDE ACTIVE &mdash;
                Vault: <strong><%= current_operator_override.vault.display_name %></strong>
                &mdash; Expires <%= distance_of_time_in_words_to_now(current_operator_override.expires_at) %>
                &mdash; Reason: <%= h current_operator_override.reason %>
              </span>
              <%= button_to "Close Override", bkc_operator_override_path, method: :delete,
                    class: "btn btn-sm btn-outline-danger ms-auto",
                    data: { turbo: false } %>
            </div>
          <% end %>
          <% if notice.present? %>
            <div class="alert alert-success" role="alert"><%= notice %></div>
          <% end %>
          <% if alert.present? %>
            <div class="alert alert-danger" role="alert"><%= alert %></div>
          <% end %>
          <%= yield %>
        </div>
      </main>
    </div>

    <script src="<%= asset_path("js/coreui.bundle.min.js") %>"></script>
  </body>
</html>
