<% content_for :title, "Users" %>
<% content_for :console_title, "User Management" %>

<div class="d-flex flex-column gap-4">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
    <div>
      <h1 class="h3 mb-1">User Management</h1>
      <p class="text-body-secondary mb-0">Control user access, roles, lifecycle status, and trust levels for the API-backed product.</p>
    </div>
    <%= link_to "New user", new_console_user_path, class: "btn btn-primary" %>
  </div>

  <section class="card border-0 shadow-sm">
    <div class="card-header">
      <%= form_with url: console_users_path, method: :get, class: "row g-2 align-items-center" do |form| %>
        <div class="col-md">
          <%= form.search_field :q, value: @query, placeholder: "Search by name, email, or Firebase UID", class: "form-control" %>
        </div>
        <div class="col-md-auto">
          <%= form.submit "Search", class: "btn btn-outline-primary" %>
        </div>
      <% end %>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th>Trust</th>
            <th class="text-end">Action</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td class="fw-semibold"><%= user.display_name %></td>
              <td><%= user.email %></td>
              <td><span class="badge text-bg-primary"><%= user.role %></span></td>
              <td><span class="badge <%= user.status == "active" ? "text-bg-success" : "text-bg-secondary" %>"><%= user.status %></span></td>
              <td>L<%= user.trust_level %></td>
              <td class="text-end"><%= link_to "Open", console_user_path(user), class: "btn btn-sm btn-outline-primary" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @users.empty? %>
      <div class="card-body text-body-secondary">No users found.</div>
    <% end %>
  </section>
</div>
