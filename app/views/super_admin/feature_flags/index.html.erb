<div class="row mb-4">
  <div class="col">
    <h2>Feature Flags</h2>
    <p class="text-muted">Manage application feature toggles using Flipper.</p>
  </div>
</div>

<div class="card shadow-sm border-0">
  <div class="card-body">
    <% if @features.any? %>
      <ul class="list-group">
        <% @features.each do |feature| %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <%= feature.name %>
            <span class="badge bg-<%= feature.enabled? ? 'success' : 'secondary' %> rounded-pill">
              <%= feature.enabled? ? 'Enabled' : 'Disabled' %>
            </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p>No feature flags configured currently.</p>
    <% end %>
    <div class="mt-4">
      <%= link_to "Back to Dashboard", super_admin_root_path, class: "btn btn-secondary" %>
    </div>
  </div>
</div>
