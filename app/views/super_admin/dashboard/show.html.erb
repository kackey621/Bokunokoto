<div class="row mb-4">
  <div class="col">
    <h2>Super Admin Dashboard</h2>
    <p class="text-muted">Overview of platform operations and core systems.</p>
  </div>
</div>

<div class="row g-4">
  <!-- Firebase Auth & Firestore -->
  <div class="col-md-6">
    <div class="card h-100 shadow-sm border-0">
      <div class="card-body">
        <h5 class="card-title">Firebase Data & Auth</h5>
        <p class="card-text">Manage users dynamically, revoke tokens, and observe Firestore telemetry.</p>
        <button class="btn btn-outline-primary" disabled>View Firestore Data</button>
      </div>
    </div>
  </div>

  <!-- Remote Config -->
  <div class="col-md-6">
    <div class="card h-100 shadow-sm border-0">
      <div class="card-body">
        <h5 class="card-title">Remote Config (Mobile)</h5>
        <p class="card-text">Update mobile application configurations without an app release.</p>
        <button class="btn btn-outline-primary" disabled>Manage Remote Config</button>
      </div>
    </div>
  </div>

  <!-- Feature Flags -->
  <div class="col-md-6">
    <div class="card h-100 shadow-sm border-0">
      <div class="card-body">
        <h5 class="card-title">Feature Flags</h5>
        <p class="card-text">Toggle application features via Flipper integration.</p>
        <button class="btn btn-outline-primary" disabled>Manage Flags</button>
      </div>
    </div>
  </div>

  <!-- FCM Notifications -->
  <div class="col-md-6">
    <div class="card h-100 shadow-sm border-0">
      <div class="card-body">
        <h5 class="card-title">Push Notifications (FCM)</h5>
        <p class="card-text">Send platform-wide announcements to users.</p>
        <button class="btn btn-outline-primary" disabled>Send Announcement</button>
      </div>
    </div>
  </div>
</div>
