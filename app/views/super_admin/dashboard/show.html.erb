<div class="row mb-4">
  <div class="col">
    <h2>Super Admin Dashboard</h2>
    <p class="text-muted">Overview of platform operations and core systems.</p>
  </div>
</div>

<div class="row g-4">
  <!-- Firebase Auth & Firestore -->
  <div class="col-md-6">
    <div class="card h-100 shadow-sm border-0">
      <div class="card-body">
        <h5 class="card-title">Firebase Data & Auth</h5>
        <p class="card-text">Manage users dynamically, revoke tokens, and observe Firestore telemetry.</p>
        <%= link_to "View Firestore Data", super_admin_firestore_index_path, class: "btn btn-outline-primary" %>
      </div>
    </div>
  </div>

  <!-- Remote Config -->
  <div class="col-md-6">
    <div class="card h-100 shadow-sm border-0">
      <div class="card-body">
        <h5 class="card-title">Remote Config (Mobile)</h5>
        <p class="card-text">Update mobile application configurations without an app release.</p>
        <%= link_to "Manage Remote Config", super_admin_remote_config_index_path, class: "btn btn-outline-primary" %>
      </div>
    </div>
  </div>

  <!-- Feature Flags -->
  <div class="col-md-6">
    <div class="card h-100 shadow-sm border-0">
      <div class="card-body">
        <h5 class="card-title">Feature Flags</h5>
        <p class="card-text">Toggle application features via Flipper integration.</p>
        <%= link_to "Manage Flags", super_admin_feature_flags_path, class: "btn btn-outline-primary" %>
      </div>
    </div>
  </div>

  <!-- FCM Notifications -->
  <div class="col-md-6">
    <div class="card h-100 shadow-sm border-0">
      <div class="card-body">
        <h5 class="card-title">Push Notifications (FCM)</h5>
        <p class="card-text">Send platform-wide announcements to users.</p>
        <%= link_to "Send Announcement", super_admin_fcm_index_path, class: "btn btn-outline-primary" %>
      </div>
    </div>
  </div>
</div>
