<div class="card shadow border-0 rounded-3">
  <div class="card-body p-5">
    <div class="text-center mb-4">
      <h2 class="fw-bold">Super Admin</h2>
      <p class="text-muted">Sign in to manage platform services</p>
    </div>

    <%= form_with url: super_admin_session_path, method: :post, local: true do |f| %>
      <div class="mb-3">
        <%= f.label :email, class: "form-label fw-semibold" %>
        <%= f.email_field :email, class: "form-control form-control-lg", required: true, autofocus: true, placeholder: "admin@example.com" %>
      </div>

      <div class="mb-4">
        <%= f.label :password, class: "form-label fw-semibold" %>
        <%= f.password_field :password, class: "form-control form-control-lg", required: true %>
      </div>

      <div class="d-grid gap-2">
        <%= f.submit "Sign In", class: "btn btn-dark btn-lg fw-semibold" %>
      </div>
    <% end %>
  </div>
</div>
