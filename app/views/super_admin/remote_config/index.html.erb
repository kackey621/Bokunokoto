<div class="row mb-4">
  <div class="col">
    <h2>Remote Config</h2>
    <p class="text-muted">View and manage mobile application remote configurations.</p>
  </div>
</div>

<div class="card shadow-sm border-0 mb-4">
  <div class="card-body">
    <h5 class="card-title">Current Configuration Template</h5>
    <% if @template.present? %>
      <pre class="bg-light p-3 rounded"><code><%= JSON.pretty_generate(@template) rescue @template.to_json %></code></pre>
    <% else %>
      <p class="text-danger">Failed to load configuration. Check your permissions and service account key.</p>
    <% end %>
  </div>
</div>

<div class="card shadow-sm border-0 mb-4">
  <div class="card-body">
    <h5 class="card-title">Update Configuration</h5>
    <%= form_with url: super_admin_remote_config_index_path, method: :post, local: true do |form| %>
      <div class="mb-3">
        <%= form.label :template_json, "Template JSON", class: "form-label fw-semibold" %>
        <%= form.text_area :template_json, class: "form-control font-monospace", rows: 15, required: true, value: (@template.present? ? JSON.pretty_generate(@template) : "") %>
        <div class="form-text">Ensure your JSON matches the Firebase Remote Config REST API format.</div>
      </div>
      <%= form.submit "Publish Template", class: "btn btn-primary" %>
      <%= link_to "Back to Dashboard", super_admin_root_path, class: "btn btn-secondary ms-2" %>
    <% end %>
  </div>
</div>
