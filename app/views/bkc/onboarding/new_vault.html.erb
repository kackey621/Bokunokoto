<div class="container py-5 text-center">
  <h1 class="display-4 mb-4">Welcome to Your BKC</h1>
  <p class="lead mb-5">You haven't created your vault yet. Start disclosing your information securely.</p>
  
  <div class="card shadow-sm mx-auto" style="max-width: 500px;">
    <div class="card-body p-4 text-start">
      <h5 class="card-title mb-3">Create Your Vault</h5>
      <%= form_with model: Vault.new, url: bkc_vault_path do |f| %>
        <div class="mb-3">
          <%= f.label :display_name, "Vault Name", class: "form-label" %>
          <%= f.text_field :display_name, class: "form-control", placeholder: "e.g. Akira's Disclosure Space", required: true %>
        </div>
        <div class="mb-3">
          <%= f.label :bio, "Bio (Optional)", class: "form-label" %>
          <%= f.text_area :bio, class: "form-control", rows: 3 %>
        </div>
        <%= f.submit "Initialize My Vault", class: "btn btn-primary w-100" %>
      <% end %>
    </div>
  </div>
</div>
