<%= form_with model: @content, url: form_url, method: form_method, local: true do |f| %>
  <% if @content.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @content.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :body, class: "form-label" %>
    <%= f.text_area :body, class: "form-control", rows: 10, required: true %>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :required_level, "Required Trust Level (0-9)", class: "form-label" %>
      <%= f.number_field :required_level, class: "form-control", in: 0..9, step: 1, required: true %>
    </div>
    <div class="col-md-6 mb-3">
      <%= f.label :format, class: "form-label" %>
      <%= f.select :format, [ [ "Markdown", "markdown" ], [ "HTML", "html" ], [ "Plain text", "text" ] ], {}, class: "form-select" %>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :symbol_type, "Symbol Type (optional)", class: "form-label" %>
    <%= f.text_field :symbol_type, class: "form-control", placeholder: "e.g. health, family, career" %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit submit_label, class: "btn btn-primary" %>
    <%= link_to "Cancel", bkc_contents_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
