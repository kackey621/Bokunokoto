<% content_for :bkc_title, "Edit Access Link - #{@access_link.slug}" %>

<div class="row">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header">
        <h4 class="mb-0">Edit Access Link</h4>
      </div>
      <div class="card-body">
        <%= render "form", access_link: @access_link %>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">Link Info</h5>
      </div>
      <div class="card-body small">
        <p><strong>Slug:</strong> <code><%= @access_link.slug %></code></p>
        <p><strong>Created:</strong> <%= @access_link.created_at.strftime("%Y-%m-%d %H:%M") %></p>
        <p><strong>Status:</strong>
          <% if @access_link.expired? %>
            <span class="badge bg-danger">Expired</span>
          <% elsif @access_link.max_uses_reached? %>
            <span class="badge bg-warning">Max Uses Reached</span>
          <% else %>
            <span class="badge bg-success">Active</span>
          <% end %>
        </p>
      </div>
    </div>
  </div>
</div>
